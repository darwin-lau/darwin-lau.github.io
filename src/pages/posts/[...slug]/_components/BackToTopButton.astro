---
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div id="btt-btn-container" class="back-to-top">
  <a href="#main-content" data-button="back-to-top">{t.post.backToTop}</a>
</div>

<style>
  .back-to-top a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    text-underline-offset: 0.25em;
  }
  .back-to-top a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
