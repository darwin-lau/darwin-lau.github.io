---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout home-layout"
  >
    <section id="hero" class="introduction" aria-labelledby="hero-heading">
      <h1 id="hero-heading">技术与研究</h1>
      <p>记录实践中的问题、方法与思考。</p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="notes-section"
          aria-labelledby="featured-heading"
        >
          <h2 id="featured-heading">{t.home.featured}</h2>
          <ul class="notes-list">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      (recentPosts.length > 0 || sortedPosts.length === 0) && (
        <section
          id="recent-posts"
          class="notes-section"
          aria-labelledby="recent-heading"
        >
          <h2 id="recent-heading">最近文章</h2>
          {sortedPosts.length === 0 ? (
            <p class="empty-message">还没有公开文章。</p>
          ) : (
            <ul class="notes-list">
              {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          )}
        </section>
      )
    }
    {
      recentPosts.length > postsConfig.perIndex && (
        <a class="more-posts" href={getRelativeLocaleUrl(locale, "posts")}>
          {t.nav.posts}
        </a>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .home-layout {
    padding-bottom: 4rem;
  }
  .introduction {
    padding-block: clamp(3rem, 6vw, 5rem) 3.5rem;
  }
  .introduction h1 {
    margin: 0;
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
  }
  .introduction p {
    max-width: 42rem;
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.8;
  }
  .notes-section {
    padding-block: 1.5rem 1rem;
  }
  .notes-section + .notes-section {
    margin-top: 1.5rem;
  }
  .notes-section > h2 {
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .notes-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .empty-message {
    margin-block: 1.5rem 3rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }
  .more-posts {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 47.99rem) {
    .introduction {
      padding-block: 2.5rem;
    }
    .introduction h1 {
      font-size: 1.875rem;
    }
    .home-layout {
      padding-bottom: 2.5rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
