---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="footer-inner">
    <div class="footer-legal">
      <small
        >{t.footer.copyright} &#169; {currentYear} {config.site.author}</small
      >
      <small>{t.footer.allRightsReserved}</small>
    </div>
    <nav class="footer-links" aria-label="页脚链接">
      {
        config.socials.map(({ name, url, linkTitle }) => (
          <a href={url} aria-label={linkTitle}>
            {name === "github" ? "GitHub" : name}
          </a>
        ))
      }
      <a href={getAssetPath("rss.xml")} aria-label="RSS 订阅"> RSS </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block-start: 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-block: 1.25rem 1.75rem;
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-links a {
    padding-block: 0.35rem;
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .footer-legal small {
    font-size: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a {
      transition: none;
    }
  }
</style>
