---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="footer-main">
    <div>
      <a class="footer-title" href={getRelativeLocaleUrl(locale, "")}>
        {config.site.title}
      </a>
      <p class="footer-description">{config.site.description}</p>
    </div>
    <nav class="footer-links" aria-label="页脚链接">
      {
        config.socials.map(({ name, url, linkTitle }) => (
          <a href={url} aria-label={linkTitle}>
            {name === "github" ? "GitHub" : name}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
      <a href={getAssetPath("rss.xml")} aria-label="RSS 订阅">
        RSS <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
  <div class="footer-meta">
    <small>{t.footer.copyright} &#169; {currentYear} {config.site.author}</small
    >
    <small>{t.footer.allRightsReserved}</small>
  </div>
</footer>

<style>
  .site-footer {
    padding-block-start: 4.5rem;
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--border);
  }

  .footer-title {
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
  }

  .footer-description {
    max-width: 38ch;
    margin: 0.65rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-block-start: 0.45rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block-end: 0.25rem;
    border-block-end: 1px solid var(--border);
    color: var(--foreground);
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .footer-links span {
    color: var(--accent);
    transition: transform 220ms ease;
  }

  .footer-links a:hover span,
  .footer-links a:focus-visible span {
    transform: translate(2px, -2px);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2.75rem 1.75rem;
    color: var(--muted-foreground);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }

  .footer-meta small {
    font-size: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a,
    .footer-links span {
      transition: none;
    }

    .footer-links a:hover span,
    .footer-links a:focus-visible span {
      transform: none;
    }
  }
</style>
