---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout page-main", className]}
>
  <header class="page-header">
    <h1 class="page-title">{pageTitle}</h1>
    {pageDesc && <p class="page-description">{pageDesc}</p>}
  </header>
  <slot />
</main>

<style>
  .page-main {
    padding-block-end: 2rem;
  }

  .page-header {
    padding-block: 2.5rem 3rem;
    margin-block-end: 1.5rem;
    border-block-end: 1px solid var(--border);
  }

  .page-header::before {
    display: block;
    width: 2.75rem;
    height: 2px;
    margin-block-end: 1.5rem;
    background: var(--accent);
    content: "";
  }

  .page-title {
    margin: 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .page-description {
    max-width: 42rem;
    margin: 1.1rem 0 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    font-style: normal;
    line-height: 1.85;
  }

  @media (min-width: 768px) {
    .page-header {
      padding-block: 3.5rem 4rem;
      margin-block-end: 2rem;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
