---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout page-main", className]}
>
  <header class="page-header">
    <h1 class="page-title">{pageTitle}</h1>
    {pageDesc && <p class="page-description">{pageDesc}</p>}
  </header>
  <slot />
</main>

<style>
  .page-main {
    padding-block-end: 2rem;
  }

  .page-header {
    padding-block: 1.75rem 1.5rem;
    margin-block-end: 0.5rem;
  }

  .page-title {
    margin: 0;
    color: var(--foreground);
    font-family: inherit;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .page-description {
    max-width: 42rem;
    margin: 0.65rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-style: normal;
    line-height: 1.8;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
